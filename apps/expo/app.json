{
  "expo": {
    "name": "storefront",
    "slug": "storefront",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "storefront",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0f"
    },
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.storefront.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0f"
      },
      "package": "com.storefront.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow this app to access your photos to upload images.",
          "cameraPermission": "Allow this app to use your camera to take photos to upload."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
